third_party/easytier/easytier-web/frontend-lib/node_modules/
third_party/easytier/easytier-web/frontend-lib/src/generated/

# protoc scratch used to build the dashboard
.protoc-bin/

# editor/agent state dirs
.mimosa/
**/.mimosa/
