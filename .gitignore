/target
Cargo.lock.bak
*.toml.tmp

# frontend build inputs (node_modules + codegen output are rebuildable);
# frontend/dist is vendored on purpose — the embed feature needs it at
# compile time and the build host has no node toolchain guarantee.
third_party/easytier/easytier-web/node_modules/
third_party/easytier/easytier-web/frontend/node_modules/
third_party/easytier/easytier-web/frontend-lib/node_modules/
third_party/easytier/easytier-web/frontend-lib/src/generated/

# protoc scratch used to build the dashboard
.protoc-bin/

# editor/agent state dirs
.mimosa/
**/.mimosa/

# Generated by third_party/rustdesk-server/build.rs on every build (it bakes the
# build date in), so it must not be tracked: otherwise every build dirties the
# working tree and one commit builds to different sources each time. The build
# script creates it before the crate is compiled, so a fresh clone is fine.
third_party/rustdesk-server/src/version.rs
